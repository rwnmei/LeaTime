<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.layout.StackPane?>
<VBox styleClass="direction"
        xmlns:fx="http://javafx.com/fxml"
      fx:controller="ui.controller.DirectionDetailsController"
      spacing="15">

    <Label styleClass="directionName" text="Название направления"/>
    <Button styleClass="backDirection" text="Назад"
            onAction="#handleBack"/>
    <Label styleClass="lastTime" text="Последнее время"/>
    <Label fx:id="lastTimeLabel"
           text="00:00:00"/>

    <Label styleClass="overallTime" text="Общее время"/>
    <Label fx:id="totalTimeLabel"
           text="00:00:00"/>
    <StackPane styleClass="stackPane"
            fx:id="chartContainer"
               prefHeight="400"/>
    <Button styleClass="day" text="День"
            onAction="#handleDay"/>

    <Button styleClass="week" text="Неделя"
            onAction="#handleWeek"/>

    <Button styleClass="month" text="Месяц"
            onAction="#handleMonth"/>

    <Button styleClass="year" text="Год"
            onAction="#handleYear"/>

</VBox>