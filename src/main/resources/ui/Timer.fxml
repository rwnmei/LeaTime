<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="timer"
        xmlns:fx="http://javafx.com/fxml"
      fx:controller="ui.controller.TimerController"
      spacing="10">

    <Label text="Таймер"/>
    <ComboBox styleClass="timerBox"
            fx:id="directionComboBox"
              promptText="Выберите направление"/>

    <Label styleClass="timerLabel" fx:id="timerLabel" text="00:00:00"/>
    <Button styleClass="startButton" fx:id="startButton"
            text="Старт"
    onAction="#handleStart"/>
    <Button styleClass="pauseButton" fx:id="pauseButton"
            text="Пауза"
    onAction="#handlePause"/>
    <Button styleClass="stopButton" fx:id="stopButton"
            text="Стоп"
    onAction="#handleStop"/>
</VBox>