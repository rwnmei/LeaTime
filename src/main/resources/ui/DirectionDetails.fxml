<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.layout.StackPane?>
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="ui.controller.DirectionDetailsController"
      spacing="15">

    <Label text="Название направления"/>
    <Button text="Назад"
            onAction="#handleBack"/>
    <Label text="Последнее время"/>
    <Label fx:id="lastTimeLabel"
           text="00:00:00"/>

    <Label text="Общее время"/>
    <Label fx:id="totalTimeLabel"
           text="00:00:00"/>
    <StackPane fx:id="chartContainer"
               prefHeight="400"/>
    <Button text="День"
            onAction="#handleDay"/>

    <Button text="Неделя"
            onAction="#handleWeek"/>

    <Button text="Месяц"
            onAction="#handleMonth"/>

    <Button text="Год"
            onAction="#handleYear"/>

</VBox>